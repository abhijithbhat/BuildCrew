ENVIRONMENT=development
# LOCAL ONLY - never set ALLOW_DEV_AUTH in production
ALLOW_DEV_AUTH=true

SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
GEMINI_API_KEY=your_gemini_api_key

APP_SECRET_KEY=your_app_secret_key_placeholder

# GitHub App Integration
GITHUB_APP_ID=your_github_app_id
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
GITHUB_APP_SLUG=your_github_app_slug
GITHUB_PRIVATE_KEY_PATH=github_private_key.pem
GITHUB_PRIVATE_KEY=your_github_private_key_pem_content_placeholder
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
